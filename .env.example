# Copie para .env (worker) e .env.local (web) e preencha. NUNCA commite valores reais.
# Para os comandos `npm run db:migrate` / `db:make-admin`, basta um .env na RAIZ do repositório só com DATABASE_URL.

# --- Postgres (puro, sem Supabase) ---
# Conexão DIRETA ou com pooler em modo "session" (5432). NÃO use pooler em modo "transaction": a fila pg-boss não funciona nele.
# Local (docker compose up -d):  postgres://mix:mix@localhost:5432/mix
DATABASE_URL=

# --- Site ---
# Endereço público do site, sem barra no fim. Usado nos links de acesso enviados por e-mail.
APP_URL=http://localhost:3000

# --- E-mail (link de acesso e convites) ---
# console = imprime o e-mail no terminal (só desenvolvimento; é recusado em produção)
# smtp    = qualquer provedor SMTP (Resend, Brevo, Amazon SES...). Exemplo de SMTP_URL: smtp://usuario:senha@smtp.exemplo.com:587
MAIL_DRIVER=console
SMTP_URL=
MAIL_FROM="Mercatta Mix <nao-responda@seudominio.com.br>"

# --- Armazenamento: Cloudflare R2 (crie o bucket e uma chave de API com acesso ao bucket) ---
# Em desenvolvimento use STORAGE_DRIVER=local e não precisa de R2.
# Em modo local, LOCAL_STORAGE_DIR deve ser um caminho ABSOLUTO e igual no site e no worker (rodam em pastas diferentes).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/caminho/absoluto/para/tmp/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Transcrição ---
# faster-whisper (padrão, roda no worker, sem custo por minuto) ou openai (whisper-1)
TRANSCRIBER=faster-whisper
WHISPER_MODEL=small
OPENAI_API_KEY=

# --- Worker ---
WORKER_CONCURRENCY=1
TMP_DIR=./tmp/work
FONTS_DIR=
